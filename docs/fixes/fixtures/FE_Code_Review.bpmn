<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_FE_Code_Review" targetNamespace="http://devtify.example/bpmn" exporter="make_bpmn.py" exporterVersion="1.0">
  <bpmn:message id="Msg_ApiReady" name="API ready" />
  <bpmn:collaboration id="Collab_FE">
    <bpmn:participant id="P_Devtify" name="Devtify – FE Development &amp; Code Review" processRef="Process_FE" />
    <bpmn:participant id="P_BE" name="BE Team (Backend)" />
    <bpmn:messageFlow id="MF_ApiReady" sourceRef="P_BE" targetRef="ICE_Api" messageRef="Msg_ApiReady" />
  </bpmn:collaboration>
  <bpmn:process id="Process_FE" name="FE Development &amp; Code Review" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_PM" name="PM / BA">
        <bpmn:flowNodeRef>T_Clarify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Dev" name="FE Dev">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Receive</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Analyze</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Spec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_AskPM</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_SpecJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Branch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Code</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Api</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ICE_Api</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Integrate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_ApiJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_PR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Fix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_MergeJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Bot" name="AI System">
        <bpmn:flowNodeRef>GW_ReviewJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Bot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Bot</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Important</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Lead" name="FE Lead">
        <bpmn:flowNodeRef>T_Lead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Approved</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Task assigned">
      <bpmn:outgoing>F01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Receive" name="Receive Task on ClickUp">
      <bpmn:incoming>F01</bpmn:incoming>
      <bpmn:outgoing>F02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Analyze" name="Analyze Spec, Figma, API">
      <bpmn:incoming>F02</bpmn:incoming>
      <bpmn:outgoing>F03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Spec" name="Spec clear?" gatewayDirection="Diverging">
      <bpmn:incoming>F03</bpmn:incoming>
      <bpmn:outgoing>F04</bpmn:outgoing>
      <bpmn:outgoing>F05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_AskPM" name="Ask PM to Clarify Spec">
      <bpmn:incoming>F05</bpmn:incoming>
      <bpmn:outgoing>F06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Clarify" name="Clarify Spec">
      <bpmn:incoming>F06</bpmn:incoming>
      <bpmn:outgoing>F07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_SpecJoin" gatewayDirection="Converging">
      <bpmn:incoming>F04</bpmn:incoming>
      <bpmn:incoming>F07</bpmn:incoming>
      <bpmn:outgoing>F08</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Branch" name="Create New Branch">
      <bpmn:incoming>F08</bpmn:incoming>
      <bpmn:outgoing>F09</bpmn:outgoing>
    </bpmn:task>
    <bpmn:userTask id="T_Code" name="Write Code &amp; Integrate">
      <bpmn:incoming>F09</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Api" name="API ready?" gatewayDirection="Diverging">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="ICE_Api" name="API ready">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_ApiReady" messageRef="Msg_ApiReady" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="T_Integrate" name="Integrate Real API">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_ApiJoin" gatewayDirection="Converging">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_PR" name="Create Pull Request">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="GW_ReviewJoin" gatewayDirection="Converging">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:incoming>F26</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="T_Bot" name="AI Bot Code Review">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_Bot" name="Bot passed?" gatewayDirection="Diverging">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
      <bpmn:outgoing>F20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="GW_Important" name="Important PR?" gatewayDirection="Diverging">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Lead" name="FE Lead Review">
      <bpmn:incoming>F22</bpmn:incoming>
      <bpmn:outgoing>F23</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_Approved" name="Code Approved?" gatewayDirection="Diverging">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T_Fix" name="Fix Review Comments">
      <bpmn:incoming>F19</bpmn:incoming>
      <bpmn:incoming>F25</bpmn:incoming>
      <bpmn:outgoing>F26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_MergeJoin" gatewayDirection="Converging">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F27</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_Merge" name="Merge Code">
      <bpmn:incoming>F27</bpmn:incoming>
      <bpmn:outgoing>F28</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End" name="PR merged">
      <bpmn:incoming>F28</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F01" sourceRef="Start" targetRef="T_Receive" />
    <bpmn:sequenceFlow id="F02" sourceRef="T_Receive" targetRef="T_Analyze" />
    <bpmn:sequenceFlow id="F03" sourceRef="T_Analyze" targetRef="GW_Spec" />
    <bpmn:sequenceFlow id="F04" name="Yes" sourceRef="GW_Spec" targetRef="GW_SpecJoin" />
    <bpmn:sequenceFlow id="F05" name="No" sourceRef="GW_Spec" targetRef="T_AskPM" />
    <bpmn:sequenceFlow id="F06" sourceRef="T_AskPM" targetRef="T_Clarify" />
    <bpmn:sequenceFlow id="F07" sourceRef="T_Clarify" targetRef="GW_SpecJoin" />
    <bpmn:sequenceFlow id="F08" sourceRef="GW_SpecJoin" targetRef="T_Branch" />
    <bpmn:sequenceFlow id="F09" sourceRef="T_Branch" targetRef="T_Code" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_Code" targetRef="GW_Api" />
    <bpmn:sequenceFlow id="F11" name="Yes" sourceRef="GW_Api" targetRef="GW_ApiJoin" />
    <bpmn:sequenceFlow id="F12" name="No (mock data)" sourceRef="GW_Api" targetRef="ICE_Api" />
    <bpmn:sequenceFlow id="F13" sourceRef="ICE_Api" targetRef="T_Integrate" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_Integrate" targetRef="GW_ApiJoin" />
    <bpmn:sequenceFlow id="F15" sourceRef="GW_ApiJoin" targetRef="T_PR" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_PR" targetRef="GW_ReviewJoin" />
    <bpmn:sequenceFlow id="F17" sourceRef="GW_ReviewJoin" targetRef="T_Bot" />
    <bpmn:sequenceFlow id="F18" sourceRef="T_Bot" targetRef="GW_Bot" />
    <bpmn:sequenceFlow id="F19" name="No" sourceRef="GW_Bot" targetRef="T_Fix" />
    <bpmn:sequenceFlow id="F20" name="Yes" sourceRef="GW_Bot" targetRef="GW_Important" />
    <bpmn:sequenceFlow id="F21" name="No" sourceRef="GW_Important" targetRef="GW_MergeJoin" />
    <bpmn:sequenceFlow id="F22" name="Yes" sourceRef="GW_Important" targetRef="T_Lead" />
    <bpmn:sequenceFlow id="F23" sourceRef="T_Lead" targetRef="GW_Approved" />
    <bpmn:sequenceFlow id="F24" name="Approved" sourceRef="GW_Approved" targetRef="GW_MergeJoin" />
    <bpmn:sequenceFlow id="F25" name="Request changes" sourceRef="GW_Approved" targetRef="T_Fix" />
    <bpmn:sequenceFlow id="F26" sourceRef="T_Fix" targetRef="GW_ReviewJoin" />
    <bpmn:sequenceFlow id="F27" sourceRef="GW_MergeJoin" targetRef="T_Merge" />
    <bpmn:sequenceFlow id="F28" sourceRef="T_Merge" targetRef="End" />
    <bpmn:textAnnotation id="Ann_Code"><bpmn:text>Use mock data if the Backend API is not ready</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_Code" sourceRef="T_Code" targetRef="Ann_Code" />
    <bpmn:textAnnotation id="Ann_Bot"><bpmn:text>Min 4 min/PR; slower when the shared bot is overloaded</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_Bot" sourceRef="T_Bot" targetRef="Ann_Bot" />
    <bpmn:textAnnotation id="Ann_Lead"><bpmn:text>Only important PRs; Lead reviews in a morning batch (8:30-9:45)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_Lead" sourceRef="T_Lead" targetRef="Ann_Lead" />
    <bpmn:textAnnotation id="Ann_Merge"><bpmn:text>Developer merges the PR</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="As_Ann_Merge" sourceRef="T_Merge" targetRef="Ann_Merge" />
  </bpmn:process>
